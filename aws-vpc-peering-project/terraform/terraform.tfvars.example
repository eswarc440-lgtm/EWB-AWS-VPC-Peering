# Copy to terraform.tfvars and edit LOCALLY. Do not commit terraform.tfvars.
aws_region        = "us-east-1"
availability_zone = "us-east-1a"       # illustrative; verify your preferred AZ
admin_ssh_cidr    = "203.0.113.10/32"  # DOCUMENTATION-ONLY IP — replace with YOUR public IPv4 /32
key_pair_name     = "vpc-peering-recovered" # imported public key must already exist in this region
instance_type     = "t3.micro"         # example size, not verified as original
